# -----------------------------------------------------------------------------
# BV Cartórios — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA comite o `.env` preenchido.
# -----------------------------------------------------------------------------

# Banco de dados (PostgreSQL). Em produção, usar Neon/Supabase na região mais
# próxima do Brasil. Local: postgresql://bv:bv@127.0.0.1:5432/bvcartorios?schema=public
DATABASE_URL="postgresql://usuario:senha@host:5432/bvcartorios?schema=public"

# URL pública da aplicação (usada em e-mails, metadados de SEO e callbacks).
APP_URL="http://localhost:3000"

# Segredo para assinatura dos cookies de sessão (mínimo 32 caracteres).
# Gere com: openssl rand -base64 48
SESSION_SECRET=""

# -----------------------------------------------------------------------------
# Seed de desenvolvimento (opcional — há valores padrão em prisma/seed.ts)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@bvcartorio.com"
SEED_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Integrações — preencher quando cada módulo entrar em desenvolvimento
# -----------------------------------------------------------------------------

# Hotmart — venda, cobrança e liberação de acesso (ver docs/HOTMART.md)
# Token da conta, usado para validar os webhooks recebidos.
HOTMART_HOTTOK=""
# Credenciais de desenvolvedor: painel da Hotmart → Ferramentas → Credenciais.
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""
HOTMART_BASIC=""

# Vídeo (Panda Video / Mux / Vimeo) — o banco guarda apenas o ID do vídeo
VIDEO_PROVIDER=""
VIDEO_API_KEY=""

# E-mail transacional (Resend / Postmark)
EMAIL_API_KEY=""
EMAIL_FROM="BV Cartórios <nao-responda@bvcartorio.com>"

# Monitoramento
SENTRY_DSN=""

# Migração do sistema legado (conexão somente leitura ao dump do banco antigo)
LEGACY_DATABASE_URL=""
